# ---------- Allgemein ----------
# Öffentliche HTTPS-Adresse dieses Servers (ohne Schrägstrich am Ende)
PUBLIC_BASE_URL=https://dein-assistent.up.railway.app
PORT=3000
TIMEZONE=Europe/Berlin
# So spricht dich der Assistent an
OWNER_NAME=Richard
# Deine Handynummer im internationalen Format – nur Anrufe von dieser Nummer werden angenommen,
# und an diese Nummer gehen die Erinnerungsanrufe
OWNER_PHONE=+49170XXXXXXX
# Optional: Zusätzliche PIN (Ziffern), die beim Anruf abgefragt wird. Leer lassen = keine PIN.
ACCESS_PIN=

# ---------- Claude (Anthropic) ----------
ANTHROPIC_API_KEY=sk-ant-...

# ---------- Twilio ----------
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# Die bei Twilio gekaufte Nummer, unter der der Assistent erreichbar ist
TWILIO_PHONE_NUMBER=+4930XXXXXXX
# Stimme (optional). Anbieter: Google | ElevenLabs | Amazon
TTS_PROVIDER=Google
TTS_VOICE=de-DE-Neural2-B
TRANSCRIPTION_PROVIDER=Deepgram

# ---------- Google Kalender ----------
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
# Wird mit "npm run google-auth" erzeugt
GOOGLE_REFRESH_TOKEN=...
# "primary" = dein Hauptkalender
GOOGLE_CALENDAR_ID=primary

# ---------- Erinnerungen ----------
# Wie viele Minuten vor einem Termin du angerufen wirst
REMINDER_MINUTES_BEFORE=15
# Morgendlicher Tagesüberblick per Anruf (HH:MM), leer = aus
MORNING_BRIEFING_TIME=07:30
# Am Wochenende keinen Tagesüberblick
MORNING_BRIEFING_WEEKDAYS_ONLY=true
# Wie oft nochmal angerufen wird, wenn du nicht rangehst
MAX_CALL_ATTEMPTS=3
RETRY_AFTER_MINUTES=3
# Termine, deren Titel eines dieser Wörter enthält, lösen keinen Anruf aus (kommagetrennt)
SKIP_KEYWORDS=Urlaub,Geburtstag,privat
# Wo der Assistent sich merkt, welche Anrufe schon raus sind
DATA_DIR=./data
