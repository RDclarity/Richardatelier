    "fastify": "^5.12.5",
    "googleapis": "^182.0.0",
    "twilio": "^6.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
